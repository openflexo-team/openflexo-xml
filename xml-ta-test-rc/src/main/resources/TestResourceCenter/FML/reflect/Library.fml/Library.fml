use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.lang.String;

@URI("http://openflexo.org/xml-test/FML/reflect/Library")
@XMLElement("Library")
public model Library {

   @XMLAttribute("name")
   String name;

   @XMLElement
   Book[0,*] books with ConceptInstance();

   @XMLElement("Book")
   public concept Book {
      String title;
      int pages;
      String category;
      String author;
   }
}
