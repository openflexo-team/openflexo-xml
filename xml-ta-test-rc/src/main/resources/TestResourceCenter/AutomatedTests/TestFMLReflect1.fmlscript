// Perform some initialization, display resources and the context
service ResourceCenterService status;
resources;
context;

// Load TestFMLReflect virtual model
virtualModel = load -r ["http://openflexo.org/xml-test/FML/reflect/TestFMLReflect1.fml"];
context;
assert virtualModel != null;
log "Pretty-print of "+virtualModel;
log virtualModel.fMLPrettyPrint;
//validate virtualModel;

// Load resources beeing used in this use case
libraryXML = load -r ["http://openflexo.org/xml-test/TestResourceCenter/XML/Library1.xml"];
log "libraryXML="+libraryXML;
assert libraryXML != null;

// Instantiate TestFMLReflect
service ResourceCenterService add_temp_rc;
myVMI = new TestFMLReflect1(libraryXML.resource) with (name="testReflect1");
context;
assert myVMI != null;
assert myVMI.library != null;
library = myVMI.library;
assert library.name == "A Library";
assert library.flexoConceptInstances.size() == 2;
book1 = library.flexoConceptInstances.get(0);
assert book1 != null;
log "book1="+book1;
book2 = library.flexoConceptInstances.get(1);
assert book2 != null;
log "book2="+book2;
