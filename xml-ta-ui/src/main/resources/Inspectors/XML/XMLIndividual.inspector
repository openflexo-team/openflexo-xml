<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector"
	layout="border" titleFont="SansSerif,0,12" darkLevel="0"
	dataClassName="org.openflexo.technologyadapter.xml.model.typed.XMLIndividual"
	controllerClassName="org.openflexo.inspector.FIBInspectorController"
	font="SansSerif,0,12" name="Inspector">
	<TabPanel name="Tab" constraints="border(location=center)">
		<Tab title="Basic" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="0" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
			name="BasicTab">

			<Label label="properties" index="3"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=0;location=left)"
				name="PropertiesLabel" localize="true" />

			<Table backgroundSelectionColor="8,74,217" index="4"
				visibleRowCount="3" backgroundNonSelectionColor="255,255,255"
				backgroundSecondarySelectionColor="212,212,212"
				iteratorClassName="? extends org.openflexo.technologyadapter.xml.metamodel.XMLProperty"
				textSelectionColor="255,255,255"
				textSecondarySelectionColor="0,0,0" lookAndFeel="Classic"
				textNonSelectionColor="0,0,0"
				selectionMode="MultipleIntervalSelection" rowHeight="18"
				manageDynamicModel="true" data="data.type.properties"
				constraints="twocols(expandHorizontally=true;expandVertically=true;insetsBottom=0;insetsLeft=0;insetsRight=0;insetsTop=0;location=right)"
				name="Table">
				<IconColumn id="11" resizable="false" title="icon"
					displayTitle="false" columnWidth="20" showIcon="false"
					name="icon" data="controller.iconForObject(iterator)" />
				<LabelColumn id="12" data="iterator.name" resizable="true"
					title="property" displayTitle="true" columnWidth="60"
					showIcon="false" name="property" />
				<LabelColumn id="13"
					data="data.getPropertyValue(iterator).toString"
					resizable="true" title="value" displayTitle="true"
					columnWidth="100" showIcon="false" name="value" />
			</Table>

		</Tab>
	</TabPanel>
	<LocalizedDictionary />
	<Parameter name="title" value="XML individual" />
</Panel>
